# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT="3000"

# MONGODB CONFIGURATION
# Provide a standard MongoDB connection URI (Atlas or local mongod).
# When omitted in local preview, the server automatically uses its persistent file-backed MongoDB store.
MONGODB_URI="mongodb://127.0.0.1:27017/keerthi_dot_exe"

# AUTHENTICATION & SECURITY SECRETS
JWT_ACCESS_SECRET="replace_with_64_char_random_hex_access_secret"
JWT_REFRESH_SECRET="replace_with_64_char_random_hex_refresh_secret"
TOKEN_ENCRYPTION_KEY="replace_with_32_byte_hex_encryption_key_for_oauth_tokens"

# INITIAL ADMIN SEEDING (Used by `npm run seed:admin`)
INITIAL_ADMIN_NAME="Keerthi Admin"
INITIAL_ADMIN_EMAIL="admin@keerthidotexe.com"
INITIAL_ADMIN_PASSWORD="ChangeMeImmediately!2026"

# META / INSTAGRAM GRAPH API INTEGRATION
INSTAGRAM_APP_ID="your_meta_instagram_app_id"
INSTAGRAM_APP_SECRET="your_meta_instagram_app_secret"
INSTAGRAM_REDIRECT_URI="http://localhost:3000/api/instagram/oauth/callback"

# SMTP EMAIL CONFIGURATION (Optional - for enquiry replies & password reset emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@keerthidotexe.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="Keerthi_dot_exe <notifications@keerthidotexe.com>"

# MEDIA STORAGE CONFIGURATION ("local" | "s3" | "cloudinary")
STORAGE_PROVIDER="local"
CLOUDINARY_URL=""
S3_BUCKET_NAME=""

